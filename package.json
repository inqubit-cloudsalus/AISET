{
  "name": "aiset",
  "version": "0.1.0",
  "description": "AISET — AI Software Engineering Team CLI",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "aiset": "./src/cli/main.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/main.ts shell",
    "aiset": "bun run src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/openai": "^4.0.53",
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "ai": "^7.0.87",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
